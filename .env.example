# Environment variables for local development
# Copy this file to .env and update the values as needed

# Database Configuration
DATABASE_URL="postgresql://postgres:password123@localhost:5432/content_curator"

# For production/cloud deployment, replace with your actual Neon database URL:
# DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# API Football Configuration
# Get your API key from https://www.api-football.com/
API_FOOTBALL_KEY="your_api_football_key_here"

# Add other environment variables your app needs here
NODE_ENV=development
